# Local dev needs NO env vars — `npm run dev` starts your own Postgres server
# and Azurite, and everything defaults to them. These are the knobs:

# Tests only: run the DB in-process via PGlite instead of connecting to a server
# PGLITE_DATA_DIR=memory://

# Who you are, until real auth arrives in Week 8 (default: demo-user)
# DEV_USER_ID=your-name

# Unset = your local dev server (postgresql://postgres:postgres@127.0.0.1:5433/postgres).
# Week 10: set this and the same code talks to Azure instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Shared class server etiquette (Week 10): keep this at 1.
# PG_POOL_MAX=1

# Blob + queue storage. Unset = Azurite, the local emulator (started by
# `npm run dev`; its data lives in .azurite/). Week 10: set this to your real
# Azure Storage account connection string and the same code talks to the cloud.
# AZURE_STORAGE_CONNECTION_STRING=

# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info
