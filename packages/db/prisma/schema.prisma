// The data model for the entire app. Users (username-only identity), Todos,
// and the thumbnail pipeline's event trail. Minimal but complete from day one.

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now())
  todos     Todo[]
}

model Todo {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  done           Boolean     @default(false)
  attachmentName String? // blob name in storage — the bytes live in Blob/Azurite, not here
  thumbnailName  String? // generated by the background worker (apps/worker/)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  events         TodoEvent[]

  @@index([userId, done])
  @@index([userId, createdAt])
}

// Things that happened to a todo. The thumbnail pipeline writes its progress
// here (queued → started → ready), and the notification stream reads from it.
enum TodoEventType {
  CREATED
  COMPLETED
  REOPENED
  THUMBNAIL_QUEUED
  THUMBNAIL_STARTED
  THUMBNAIL_READY
}

model TodoEvent {
  id        String        @id @default(cuid())
  todoId    String
  todo      Todo          @relation(fields: [todoId], references: [id], onDelete: Cascade)
  type      TodoEventType
  createdAt DateTime      @default(now())

  @@index([todoId, createdAt])
}
