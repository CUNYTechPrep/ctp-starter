{
  "name": "@project/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":            { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./migrate":    { "types": "./src/apply-migrations.ts", "default": "./src/apply-migrations.ts" }
  },
  "scripts": {
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf src/generated"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@electric-sql/pglite": "^0.5.4",
    "pglite-prisma-adapter": "0.6.1",
    "pg": "^8.13.0",
    "@project/log": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "@types/pg": "^8.11.0",
    "vitest": "^4.0.0"
  }
}