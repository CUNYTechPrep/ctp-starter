{
  "name": "starter-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -n turbo,azurite -c cyan,magenta \"turbo run dev --parallel --filter '!@project/migrate'\" \"azurite --silent --skipApiVersionCheck --location .azurite\"",
    "build": "turbo run build",
    "start": "pnpm --filter @project/web start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @project/migrate dev",
    "db:reset": "rm -rf .pgdata && echo \"Restart pnpm dev (db re-initializes + migrations re-apply)\"",
    "db:dev": "pnpm --filter @project/db-server dev",
    "prisma:generate": "pnpm --filter @project/db generate",
    "dev:web": "pnpm --filter @project/web dev",
    "azurite": "azurite --silent --skipApiVersionCheck --location .azurite",
    "worker": "pnpm --filter @project/worker dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "^2.5.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "azurite": "^3.33.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@project/db": "workspace:*",
    "@project/domain": "workspace:*"
  }
}
