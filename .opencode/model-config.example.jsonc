{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 2,
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": { 
          "name": "DeepSeek V4 Flash",
          "provider": {
            "data_collection": "deny",
          },
        },
        "minimax/minimax-m3": {
          "name": "MiniMax M3",
          "provider": {
            "data_collection": "deny"
          }
        },
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "provider": {
            "data_collection": "deny"
          }
        }
      }
    }
  },
  "agent": {
    "plan":                { "model": "openrouter/z-ai/glm-5.2" },
    "mentor":              { "model": "openrouter/z-ai/glm-5.2" },
    "review":              { "model": "openrouter/z-ai/glm-5.2" },
    
    "architect-monorepo":  { "model": "openrouter/minimax/minimax-m3" },
    "review-migrations":   { "model": "openrouter/minimax/minimax-m3" },
    "review-architecture": { "model": "openrouter/minimax/minimax-m3" },
    "review-skills":       { "model": "openrouter/minimax/minimax-m3" },
    "review-tests":        { "model": "openrouter/minimax/minimax-m3" },
    "review-security":     { "model": "openrouter/minimax/minimax-m3" },
    "review-boundaries":   { "model": "openrouter/minimax/minimax-m3" },
    "review-docs":         { "model": "openrouter/minimax/minimax-m3" },

    "build":               { "model": "openrouter/deepseek/deepseek-v4-flash" },
    "research":            { "model": "openrouter/deepseek/deepseek-v4-flash" }
  }
}
